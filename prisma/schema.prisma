generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["newsletter", "public"]
}

model AuthCode {
  id               BigInt    @id @default(autoincrement())
  email            String
  codeHash         String    @map("code_hash")
  purpose          String    @default("sign_in")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestIp        String?   @map("request_ip")
  requestUserAgent String?   @map("request_user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, expiresAt(sort: Desc)], map: "auth_codes_email_expires_idx")
  @@map("auth_codes")
  @@schema("newsletter")
}

model Issue {
  id                  BigInt    @id @default(autoincrement())
  title               String
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  html                String?
  featureImageUrl     String?   @map("feature_image_url")
  excerpt             String?
  contentJson         Json?     @map("content_json")
  /// At most one issue per date (#82).
  issueDate           DateTime? @unique @map("issue_date") @db.Date
  promptFeaturedImage String?   @map("prompt_featured_image")
  slug                String?   @unique @default(dbgenerated("COALESCE(newsletter.slugify_issue_title(title), (id)::text)"))
  note                String?
  /// 'draft' or 'published' (#82). The database computes it from published_at (a generated column), so never
  /// write it. Read it to ask "is this issue published?"; read published_at for the time.
  status              String    @default(dbgenerated())

  @@unique([title, publishedAt], map: "issues_title_published_unique")
  @@index([createdAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@map("issues")
  @@schema("newsletter")
}

model ScraperBookmark {
  source      String   @id
  lastSuccess DateTime @map("last_success") @db.Timestamptz(6)

  @@map("scraper_bookmarks")
  @@schema("newsletter")
}

model Story {
  id                       Int       @id @default(autoincrement())
  guid                     String?   @unique
  day                      DateTime? @db.Date
  headline                 String?
  url                      String?
  summary                  String?
  category                 String?
  source                   String?
  createdAt                DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime? @default(now()) @db.Timestamptz(6)
  storyDetails             String?   @map("story_details")
  importanceScore          Int?      @map("importance_score") @db.SmallInt
  usedInPublicationDate    DateTime? @map("used_in_publication_date") @db.Date
  queuedForPublicationDate DateTime? @map("queued_for_publication_date") @db.Date
  excludeFromCandidates    Boolean?  @default(false) @map("exclude_from_candidates")
  note                     String?
  paywallDetected          String?   @map("paywall_detected")
  error                    String?
  /// When the repeat check (#90) went through the story. Null means not checked yet.
  matchedAt                DateTime? @map("matched_at") @db.Timestamptz(6)
  /// The board date of the commit that excluded the story. Null for stories excluded before #90.
  excludedOn               DateTime? @map("excluded_on") @db.Date
  /// When the search for free links (#59) finished for the story, also with no result. Null means not searched.
  freeLinksCheckedAt       DateTime? @map("free_links_checked_at") @db.Timestamptz(6)
  /// When a run of the search for free links (#59) claimed the story. A claim older than 15 minutes is void.
  freeLinksStartedAt       DateTime? @map("free_links_started_at") @db.Timestamptz(6)
  /// The original link (#59): the link the story had before a commit first changed it. Null means never changed.
  originalUrl              String?   @map("original_url")

  @@index([queuedForPublicationDate], map: "queued_for_publication_date_idx")
  @@index([day], map: "stories_day_idx")
  @@map("stories")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Subscriber {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique
  status       String    @default("active")
  source       String    @default("article_gate")
  subscribedAt DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  firstName    String?   @map("first_name")

  @@index([status])
  @@map("subscribers")
  @@schema("newsletter")
}

model schema_migrations {
  filename   String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// Pipeline tables (#47). Additive only: n8n never reads them.

model PipelineSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("pipeline_settings")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PipelineRun {
  id         BigInt          @id @default(autoincrement())
  job        String
  trigger    String
  status     String          @default("running")
  startedAt  DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?       @map("finished_at") @db.Timestamptz(6)
  stats      Json?
  error      String?
  events     PipelineEvent[]

  @@index([job, startedAt(sort: Desc)])
  @@map("pipeline_runs")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PipelineEvent {
  id        BigInt      @id @default(autoincrement())
  runId     BigInt      @map("run_id")
  level     String
  step      String
  message   String
  data      Json?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  run       PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("pipeline_events")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One row per sent issue email that native publish detection looked at, and per manual "Mark as published".
/// mode: shadow (records what it would do), native (published), manual (admin button).
/// No foreign key to issues: issues are still deleted by hand while n8n drafts.
model PublishEvent {
  id             BigInt   @id @default(autoincrement())
  mode           String
  outcome        String
  gmailMessageId String?  @map("gmail_message_id")
  receivedAt     DateTime? @map("received_at") @db.Timestamptz(6)
  issueId        BigInt?  @map("issue_id")
  subject        String?
  title          String?
  storyIds       Int[]    @default([]) @map("story_ids")
  contentJson    Json?    @map("content_json")
  problems       String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// The native draft the sent email was made from (its data-draft-id). NULL for n8n's emails.
  draftId        BigInt?  @map("draft_id")
  /// The staged version the sent email was made from (its data-version-id). NULL for emails staged before #149.
  stagedVersionId BigInt? @map("staged_version_id")

  @@unique([mode, gmailMessageId])
  @@index([issueId])
  @@index([createdAt(sort: Desc)])
  @@index([draftId])
  @@map("publish_events")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// open_incident_key equals incident_key while the alert is open and is NULL once resolved,
/// so the unique index allows one open alert per incident and any number of resolved ones.
model Alert {
  id              BigInt    @id @default(autoincrement())
  incidentKey     String    @map("incident_key")
  openIncidentKey String?   @unique @map("open_incident_key")
  severity        String
  status          String    @default("open")
  firstSeen       DateTime  @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen        DateTime  @default(now()) @map("last_seen") @db.Timestamptz(6)
  notifiedAt      DateTime? @map("notified_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  message         String
  context         Json?

  @@index([incidentKey, firstSeen(sort: Desc)])
  @@index([status, firstSeen])
  @@map("alerts")
  @@schema("newsletter")
}

/// A weekday the owner chose not to publish an issue (#52): "No issue today" on /approval.
/// The check job skips that date's checks. Undo deletes the row.
model SkippedDate {
  date      DateTime @id @db.Date
  note      String?
  createdBy String   @default("approval") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("skipped_dates")
  @@schema("newsletter")
}

/// Fixed-window counters for login and sign-up limits (#53). key is "<rule>:<sha256 of the IP, email, or
/// code id>", so no address is stored. The app deletes rows a day after their window starts.
model RateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)

  @@index([windowStartedAt])
  @@map("rate_limits")
  @@schema("newsletter")
}

/// One row per board commit (#75): the normalised outline and its sha256 (of payload only).
/// proposed is the proposed board (#150): { sections: { key, storyIds }[], leadStoryId, repeatsRemoved }. NULL for
/// commits before #150.
model ApprovalOutline {
  id          BigInt    @id @default(autoincrement())
  issueDate   DateTime  @map("issue_date") @db.Date
  payload     Json
  payloadHash String    @map("payload_hash")
  committedAt DateTime  @default(now()) @map("committed_at") @db.Timestamptz(6)
  proposed    Json?

  @@index([issueDate, committedAt(sort: Desc)])
  @@map("approval_outlines")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// A board action (#150): one difference between the proposed board and the committed outline, written at commit
/// (board-diff.ts). action is exclude, add, restore_repeat, move, reorder, lead, or link (CHECK constraint in the
/// migration). story_id is null for reorder, and for lead when the lead was cleared. reason_code and reason_text
/// are the owner's optional reason. detail holds the reorder's before/after, the lead's from, or the link's
/// from/to. No foreign keys, like the other pipeline tables.
model BoardAction {
  id           BigInt   @id @default(autoincrement())
  outlineId    BigInt   @map("outline_id")
  issueDate    DateTime @map("issue_date") @db.Date
  storyId      Int?     @map("story_id")
  action       String
  fromSection  String?  @map("from_section")
  toSection    String?  @map("to_section")
  fromPosition Int?     @map("from_position")
  toPosition   Int?     @map("to_position")
  reasonCode   String?  @map("reason_code")
  reasonText   String?  @map("reason_text")
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([outlineId])
  @@index([issueDate, action])
  @@map("board_actions")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One row per draft of an issue (#76, ADR 0002). Each commit makes the next version, counting from 1 per issue.
/// status is running, ready, or failed (CHECK constraint in the migration). current_step is the step running now,
/// for the board's live progress. started_at is when the current attempt began (a retry clears it).
/// No foreign keys: issues are still deleted by hand while n8n drafts.
model IssueDraft {
  id               BigInt    @id @default(autoincrement())
  issueId          BigInt    @map("issue_id")
  version          Int
  outlineId        BigInt    @map("outline_id")
  status           String    @default("running")
  currentStep      String?   @map("current_step")
  failedStep       String?   @map("failed_step")
  error            String?
  content          Json?
  html             String?
  featuredImageUrl String?   @map("featured_image_url")
  scenePrompt      String?   @map("scene_prompt")
  ghlTemplateId    String?   @map("ghl_template_id")
  ghlPreviewUrl    String?   @map("ghl_preview_url")
  unreadStoryIds   Int[]     @default([]) @map("unread_story_ids")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the draft last waited for its job: set on create and on retry. A draft whose job never starts is
  /// stuck after 5 minutes (draft-store.ts isStuckDraft).
  queuedAt         DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  /// A "New image" draft (#116): the ready draft whose written content it re-uses. Null for a commit's draft.
  sourceDraftId    BigInt?   @map("source_draft_id")
  /// When the owner last changed the draft's title or image in the app (#149). NULL for a draft nobody changed.
  editedAt         DateTime? @map("edited_at") @db.Timestamptz(6)

  @@unique([issueId, version])
  @@map("issue_drafts")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One row per staged version of an issue (#149, ADR 0005): the exact title, image, content, and HTML the owner
/// staged for sending, numbered from 1 per issue. status is staging (the call to the distribution service is
/// running) or staged (CHECK constraint in the migration). A staged row never changes. id is the hidden
/// data-version-id in the staged email. service is the distribution service's key; service_ref is the id that
/// service returned. No foreign keys, like the other pipeline tables.
model StagedVersion {
  id               BigInt    @id @default(autoincrement())
  issueId          BigInt    @map("issue_id")
  version          Int
  draftId          BigInt    @map("draft_id")
  status           String
  title            String
  featuredImageUrl String?   @map("featured_image_url")
  scenePrompt      String?   @map("scene_prompt")
  content          Json
  html             String
  service          String
  serviceRef       String?   @map("service_ref")
  serviceUrl       String?   @map("service_url")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  stagedAt         DateTime? @map("staged_at") @db.Timestamptz(6)

  @@unique([issueId, version])
  @@index([draftId])
  @@map("staged_versions")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// The article reader's saved copy (#120): one row per story and link it tried. A later commit reuses a row whose
/// status is read; a link edited on the board is a new row and is read again. status is read, paywalled, blocked,
/// or failed (CHECK constraint in the migration). text is the article's plain text, cut to 50,000 characters.
/// attempts is each method's outcome (method, ms, chars, outcome, httpStatus, error). issue_id is the issue whose
/// draft last saved the row. The draft job clears text (keeping the rest) once that issue was published over 14 days
/// ago, or the copy is over 30 days old; a row with no text is read again if needed. No foreign key, like the other
/// pipeline tables.
model StoryArticle {
  id       BigInt   @id @default(autoincrement())
  storyId  Int      @map("story_id")
  url      String
  issueId  BigInt?  @map("issue_id")
  status   String
  method   String?
  finalUrl String?  @map("final_url")
  text     String?
  chars    Int      @default(0)
  error    String?
  attempts Json?
  readMs   Int?     @map("read_ms")
  readAt   DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  @@unique([storyId, url])
  @@map("story_articles")
  @@schema("newsletter")
}

/// Which newsletters covered a story (#58): one row per story and source key, written by ingestion. stories.source
/// keeps only the last source to write a row (two sources with the same link on the same day share one row), so
/// the board reads coverage across sources from here. No foreign key, like the other pipeline tables.
model StorySource {
  storyId     Int      @map("story_id")
  source      String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)

  @@id([storyId, source])
  @@map("story_sources")
  @@schema("newsletter")
}

/// One embedding for each story (#90): 512 numbers from text-embedding-3-small of headline, newline, summary,
/// with length 1. Made once, by the repeat check. No foreign key, like the other pipeline tables.
model StoryEmbedding {
  storyId   Int      @id @map("story_id")
  model     String
  vector    Float[]  @db.Real
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("story_embeddings")
  @@schema("newsletter")
}

/// A story match (#90): one judged pair of stories. newer_story_id is the story with the later day (same day: the
/// higher id). similarity is the cosine similarity of their embeddings; same and news are the judge's two answers
/// (probabilities). repeat-rules.ts (src/pipeline/repeats/) turns these rows into repeats, duplicates and labels.
model StoryMatch {
  id           BigInt   @id @default(autoincrement())
  newerStoryId Int      @map("newer_story_id")
  olderStoryId Int      @map("older_story_id")
  similarity   Float    @db.Real
  same         Float    @db.Real
  news         Float    @db.Real
  judgedAt     DateTime @default(now()) @map("judged_at") @db.Timestamptz(6)

  @@unique([newerStoryId, olderStoryId])
  @@index([olderStoryId])
  @@map("story_matches")
  @@schema("newsletter")
}

/// A free link (#59) for a story with a paywalled link: an article that reports the same news, that the app could
/// read, and that has 300 words or more. position 0 is the one the board selects. origin is where it came from:
/// `story` (one of our own stories, origin_story_id) or `search` (the web search).
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model StoryFreeLink {
  id            BigInt   @id @default(autoincrement())
  storyId       Int      @map("story_id")
  position      Int
  url           String
  site          String
  title         String?
  words         Int
  origin        String
  originStoryId Int?     @map("origin_story_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([storyId, url])
  @@map("story_free_links")
  @@schema("newsletter")
}

/// A site the article reader found paywalled (#59). story_ids are the distinct stories whose suggested link was
/// paywalled there. The site is a learned paywalled site when it has 2 or more story ids and is not ignored.
model PaywallSite {
  site      String   @id
  storyIds  Int[]    @default([]) @map("story_ids")
  ignored   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("paywall_sites")
  @@schema("newsletter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// One row for each story in each published issue (#118, ADR 0007): what the sent email held, written at publish
/// from the parsed email (publish-store.ts). section is headlines, research_and_analysis, tools, or quick_hits
/// (CHECK constraint in the migration). position is the place in the section, from 1. url is the link that was
/// sent. is_lead is null when the sent draft is not known (the backfill, and emails that name no draft).
/// No foreign keys, like the other pipeline tables.
model IssueStory {
  issueId   BigInt   @map("issue_id")
  storyId   Int      @map("story_id")
  section   String
  position  Int
  url       String?
  isLead    Boolean? @map("is_lead")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([issueId, storyId])
  @@index([storyId])
  @@map("issue_stories")
  @@schema("newsletter")
}
