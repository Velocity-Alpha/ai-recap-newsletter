{
  "name": "va_newsletter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify": "npm run lint && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "db:bootstrap": "node scripts/run-db-bootstrap.mjs --url-env DATABASE_URL",
    "db:bootstrap:prod": "node scripts/run-db-bootstrap.mjs --url-env PRODUCTION_DATABASE_URL",
    "db:reset-dev": "node --env-file-if-exists=.env.local scripts/reset-dev-branch.mjs",
    "prisma:migrate:prod:baseline": "node scripts/run-prisma-prod.mjs migrate resolve --applied 0_init",
    "prisma:migrate:prod:status": "node scripts/run-prisma-prod.mjs migrate status",
    "prisma:migrate:prod:deploy": "node scripts/run-prisma-prod.mjs migrate deploy && npm run db:bootstrap:prod"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "^0.12.23",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@trigger.dev/sdk": "^4.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "linkedom": "^0.18.15",
    "lucide-react": "^0.522.0",
    "next": "^16.4.5",
    "node-html-parser": "^9.0.7",
    "openai": "^6.37.0",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "^4.8.3",
    "@types/node": "^18",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
