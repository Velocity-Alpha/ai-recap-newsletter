# Next.js Environment Variables
# Copy this file to .env.local and update the values

# Required. Which deployment this is: development (laptop), preview (Netlify deploy previews and branch
# deploys), or production. `next dev` and `next build` stop if it is missing or invalid.
# Netlify sets it per deploy context in netlify.toml.
APP_ENV=development

# Site URL used for OpenGraph metadataBase (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://airecap.news

# Optional Google Analytics measurement ID for local testing only.
# Leave unset in local development unless you intentionally want to send data to a non-production GA property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8GQC9DS1S7

# Server-side database connection for newsletter reads, article gating, and OTP flows.
# On a laptop, point this at the Neon `dev` branch (fake subscribers), not production.
# DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Optional separate production database URL for `npm run prisma:migrate:prod:*` commands.
# PRODUCTION_DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Optional runtime database role name for grant/bootstrap scripts.
# NEWSLETTER_RUNTIME_DB_ROLE=newsletter_web

# Neon project id for `npm run db:reset-dev`, which resets the Neon `dev` branch from production
# and replaces subscribers and login codes with fake rows. Needs a Neon CLI login (`npx neonctl auth`).
# NEON_PROJECT_ID=your-neon-project-id

# Cookie signing secret for subscriber sessions.
# SESSION_SECRET=replace_me_with_a_long_random_string

# Resend configuration for OTP emails.
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_NAME=AI Recap
# RESEND_FROM_EMAIL=login@updates.airecap.news

# Which list the subscribe form writes to: "beehiiv" (default) or "ghl".
# SUBSCRIBER_PROVIDER=beehiiv

# Beehiiv configuration, used when SUBSCRIBER_PROVIDER=beehiiv.
# BEEHIIV_API_KEY=your_beehiiv_api_key
# BEEHIIV_PUBLICATION_ID=pub_xxxxx

# GHL inbound webhook for new subscribers, used when SUBSCRIBER_PROVIDER=ghl.
# GHL_SUBSCRIBE_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...



# Password protecting the /approval route.
# APPROVAL_PASSWORD=replace_me_with_a_strong_password

# Secret used to sign approved outline payloads forwarded to n8n.
# Generate this in n8n and configure it in both places to verify JWT signatures.
# N8N_WEBHOOK_JWT_SECRET=your_n8n_generated_secret_key

# Where the approval board's commit goes. Required outside production, and it must not be the production
# n8n webhook (the route refuses it). Production defaults to the production webhook.
# OUTLINE_COMMIT_WEBHOOK_URL=https://n8n.velocityalpha.com/webhook-test/story/approval

# OpenRouter is used for approval outline deduplication.
# OPENROUTER_API_KEY=sk-or-v1-xxxxx
# OPENROUTER_DEDUP_TIMEOUT_MS=60000

# Shared secret for authenticated unsubscribe webhooks.
# Get this from your GoHighLevel (GHL) webhook configuration.
# GHL_UNSUBSCRIBE_WEBHOOK_SECRET=your_ghl_webhook_secret

# Optional override for the for-brands webhook destination.
# FOR_BRANDS_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trigger.dev background jobs. Use the DEVELOPMENT secret key from the Trigger.dev dashboard
# (API keys page). The production key lives only in Netlify / Trigger.dev env vars.
# TRIGGER_SECRET_KEY=tr_dev_xxxxx

# Read-only Gmail access for publish detection (detect-publish task). Scope gmail.readonly.
# GMAIL_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GMAIL_OAUTH_CLIENT_SECRET=xxxxx
# GMAIL_OAUTH_REFRESH_TOKEN=xxxxx
# The one seed address to read: the monitor seed, not the owner's + alias. Each send reaches both in the
# same inbox, so without this every send is read twice. Takes a comma-separated list, but use one address.
# PUBLISH_SEED_RECIPIENTS=seed@example.com

# GHL email templates for native drafting (one new template per draft). Production only: elsewhere the
# calls are recorded, not sent. GHL_USER_ID is sent as `updatedBy` when the template HTML is set.
# GHL_PRIVATE_INTEGRATION_TOKEN=pit-xxxxx
# GHL_LOCATION_ID=xxxxx
# GHL_USER_ID=xxxxx

# Ops alerts (src/pipeline/notify/), sent only when APP_ENV=production; elsewhere the run log records the text.
# The review bot (TELEGRAM_REVIEW_BOT_TOKEN) posts them to the "AI Recap Ops" chat. Never the review group id.
# TELEGRAM_OPS_CHAT_ID=-100xxxxxxxxxx
